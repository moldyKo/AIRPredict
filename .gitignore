# =========================================
# AIRPredict - Git ignore
# =========================================

# Python virtual environment
Backend/venv/
Backend/.venv/
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Backend secrets
Backend/.env
Backend/.env.*
.env
.env.*

# Frontend dependencies
Frontend/node_modules/
node_modules/

# Next.js build files
Frontend/.next/
.next/
out/

# Frontend local environment
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.production.local
Frontend/.env.test.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp